# Dokploy service "Backoffice": Build Type = Dockerfile, Base Directory = /frontend, Dockerfile = Dockerfile.backoffice
# Env: BACKEND_URL=http://<backend service host>:8000 · Domain: dashtorbackoffice.laveyent.com -> port 3000
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:backoffice

FROM caddy:2-alpine
WORKDIR /app
COPY --from=build /app/dist-backoffice ./dist-backoffice
COPY caddy.backoffice.conf ./caddy.conf
ENV PORT=3000
EXPOSE 3000
CMD ["caddy", "run", "--config", "caddy.conf", "--adapter", "caddyfile"]
