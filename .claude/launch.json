{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-bench",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5176",
        "--strictPort"
