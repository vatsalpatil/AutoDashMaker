# Copy to backend/.env locally, or set these as Environment variables in the Dokploy backend service.
AUTH_ENABLED=true
# Where these come from in the self-hosted Supabase (Dokploy) environment:
#   SUPABASE_URL          <- SUPABASE_PUBLIC_URL / API_EXTERNAL_URL (the https address of Supabase)
#   SUPABASE_ANON_KEY     <- ANON_KEY (public; the browser receives it)
#   SUPABASE_JWT_SECRET   <- JWT_SECRET (HS256 projects; leave empty only if you switched to ES256/JWKS keys)
#   SUPABASE_SERVICE_KEY  <- SERVICE_ROLE_KEY (SECRET, backend only: never put it in the frontend or in git)
SUPABASE_URL=https://supabase.yourdomain.com
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Lets the backend change a user's email after they proved the new address (Settings > Account). Empty = email change off.
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=["https://app.yourdomain.com"]
# Size to the server (default 6GB is for the old dev box).
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=2
# Python transforms run in-process and can read server files: keep false on any multi-user server.
ALLOW_USER_PYTHON=false
# Refuse uploads/imports above this % of disk usage (0 = off).
DISK_USAGE_LIMIT_PCT=80
# Per-user limits (hosted mode only). Storage counts the compressed Parquet files.
MAX_UPLOAD_MB=50
USER_QUOTA_MB=250
MAX_ROWS_PER_DATASET=5000000
MAX_DATASETS=20

# --- Account verification (email + mobile one-time codes) ---------------------------------------------------
# Leave VERIFICATION_REQUIRED=false until email AND SMS delivery below are configured, otherwise users cannot
# receive their codes. Users who signed up before this feature get the grace period from their first visit.
VERIFICATION_REQUIRED=false
VERIFICATION_GRACE_DAYS=7
# Which channels count (set one to false to require only email or only mobile).
# Mobile is OFF for now: set VERIFICATION_PHONE=true later (and add an SMS/WhatsApp/Telegram sender) to turn it on;
# existing users then get the banner + grace period. With it off, an email change is proven with a code to the CURRENT email.
VERIFICATION_EMAIL=true
VERIFICATION_PHONE=false
# Email via any SMTP server (Gmail app password, Resend, SendGrid, Brevo, Zoho...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dashtor <no-reply@yourdomain.com>
# SMS via Twilio (sms_provider=console only writes the code to the server log)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Random string used to hash stored codes (falls back to SUPABASE_JWT_SECRET)
VERIFICATION_SECRET=
